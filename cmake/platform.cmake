# Common CMake helpers, paths, flags, and codegen target wrappers

get_filename_component(REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(AOSP_SRC "${REPO_ROOT}/src")
set(GEN_DIR "${REPO_ROOT}/build/generated")
set(HOST_TOOLS_BIN "${REPO_ROOT}/build/host-tools/bin")
set(TARGET_PREBUILTS "${REPO_ROOT}/build/target-libs")

set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS ON) # gnu++20 by default, overridden per-target where needed

# Keep __ANDROID__ defined for NDK Bionic libc & libc++ STL headers;
# LAYOUTLIB_HOST distinguishes Termux host-profile builds from Android OS device HALs.
add_compile_definitions(
    _FILE_OFFSET_BITS=64
    LAYOUTLIB_HOST=1
)

# Permissive flags for cross-compiling AOSP with NDK Clang 19 without Soong -Werror churn
add_compile_options(
    -fPIC
    -ffunction-sections
    -fdata-sections
    -Wno-unused-parameter
    -Wno-unused-variable
    -Wno-unused-function
    -Wno-unused-const-variable
    -Wno-unused-result
    -Wno-c99-designator
    -Wno-gnu-designator
    -Wno-missing-field-initializers
    -Wno-deprecated-declarations
    -Wno-sign-compare
    -Wno-reorder-init-list
    -Wno-macro-redefined
)

# Helper to define an aconfig C++ static library generated by tools/gen_aconfig.py
function(aosp_add_aconfig_lib TARGET_NAME DIR_NAME)
    set(_dir "${GEN_DIR}/aconfig/${DIR_NAME}")
    file(GLOB _srcs "${_dir}/*.cc" "${_dir}/*.cpp")
    add_library(${TARGET_NAME} STATIC ${_srcs})
    target_include_directories(${TARGET_NAME} PUBLIC "${_dir}/include")
    set_target_properties(${TARGET_NAME} PROPERTIES POSITION_INDEPENDENT_CODE ON)
endfunction()

# Interface library for cxxbridge generated header (<rust/cxx.h>)
add_library(cxx_bridge_headers INTERFACE)
target_include_directories(cxx_bridge_headers INTERFACE "${GEN_DIR}/cxx/include")

# Interface library for Bionic kernel UAPI headers (input-event-codes.h, binder.h, etc.)
add_library(bionic_uapi_headers INTERFACE)
target_include_directories(bionic_uapi_headers INTERFACE
    "${AOSP_SRC}/bionic/libc/kernel/uapi"
    "${AOSP_SRC}/bionic/libc/kernel/android/uapi"
)

# Interface library for AOSP system/core/include (<system/*.h>, <cutils/...>, etc.)
add_library(aosp_system_headers INTERFACE)
target_include_directories(aosp_system_headers INTERFACE
    "${AOSP_SRC}/system/core/include"
)
